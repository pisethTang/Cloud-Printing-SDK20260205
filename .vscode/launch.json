{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "FastAPI: demo_app (uvicorn)",
			"type": "debugpy",
			"request": "launch",
			"python": "${workspaceFolder}/httpserver-fastapi/.venv/Scripts/python.exe",
			"module": "uvicorn",
			"args": [
				"demo_app:app",
				"--host",
				"0.0.0.0",
				"--port",
				"8800",
				"--reload"
			],
			"cwd": "${workspaceFolder}/httpserver-fastapi",
			"console": "integratedTerminal",
			"justMyCode": true
		}
	]
}
